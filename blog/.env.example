# Copy to .env and fill in. docker-compose.yml reads it for app/worker/scheduler.
#
# JWT_SECRET MUST be valid base64 — Loco decodes it with
# `EncodingKey::from_base64_secret`; anything else makes every login fail
# with a bare "unauthorized!". Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Public URL (links in emails, RSS, sitemap) and the mailer's host
BASE_URL=http://localhost:5150
HOST=http://localhost:5150
MAIL_FROM=Loco Blog <noreply@example.com>
# true behind HTTPS; false only for plain-http local testing
COOKIE_SECURE=false
# Real SMTP: set host/port/secure and credentials. Leave the credentials
# unset for a relay without AUTH (the compose file uses Mailpit).
# MAILER_HOST=smtp.example.com
# MAILER_PORT=587
# MAILER_SECURE=true
# MAILER_USER=
# MAILER_PASSWORD=
LOG_LEVEL=info
